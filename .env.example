# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty for demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Claude API key for the dispute analyst (console.anthropic.com).
ANTHROPIC_API_KEY=
# Shared passcode that gates analyses, sending, and store tools. Required on any public deploy.
APP_PASSCODE=
# Where JSON records live (default .data).
DATA_DIR=
FORCE_DEMO=
# Model for the analyst. Defaults to Haiku (development); set claude-opus-5-5 on the hosted demo.
AI_MODEL=claude-haiku-5-5
# Max AI analyses per UTC day (protects a public demo from running up the bill).
AI_DAILY_CAP=25
